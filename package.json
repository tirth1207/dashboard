{
  "name": "lifeos",
  "private": true,
  "version": "1.0.0",
  "description": "LifeOS AI personal analytics platform monorepo",
  "packageManager": "pnpm@10.12.1",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "db:generate": "pnpm --filter @lifeos/database db:generate",
    "db:migrate": "pnpm --filter @lifeos/database db:migrate",
    "db:seed": "pnpm --filter @lifeos/database db:seed"
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
    "@types/node": "^22.15.30",
    "prettier": "^3.5.3",
    "turbo": "^2.5.4",
    "typescript": "^5.8.3"
  }
}
